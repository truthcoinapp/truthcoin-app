{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Truthcoin App",
  "mainBinaryName": "truthcoin-app",
  "version": "0.1.3",
  "identifier": "dev.truthcoinapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Truthcoin App",
        "width": 480,
        "height": 840,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["script-src"]
    }
  },
  "plugins": {
    "shell": {
      "open": "https://(github\\.com/truthcoinapp/truthcoin-app/(releases|issues/new|security/advisories/new)|github\\.com/LayerTwo-Labs/truthcoin-dc/releases|truthcoinapp\\.github\\.io/truthcoin-app)([/?][A-Za-z0-9._~%/?=&#+-]*)?"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "homepage": "https://github.com/truthcoinapp/truthcoin-app",
    "publisher": "The Truthcoin App developers",
    "copyright": "Copyright (c) 2026 The Truthcoin App developers",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Finance",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
